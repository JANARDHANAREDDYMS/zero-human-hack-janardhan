# Fill backend/.env locally. Never paste secrets into chat.
# Use: python3 -m customer_generation --env-file backend/.env check-config
MODEL_BACKEND=openrouter
EXA_API_KEY=
# Optional override; blank uses your existing Codex configured model.
CODEX_MODEL=
# Legacy optional bridge settings; not needed for direct OpenRouter access.
MODEL_BRIDGE_URL=
MODEL_BRIDGE_TOKEN=
# Exact gateway model ID enabled in your Lovable project, not a display label.
MODEL_ID=
# Deferred integrations; not required or consumed by customer generation yet.
TERAC_API_KEY=
WHOP_API_KEY=
# Whop phase 1. Production key and sandbox key are separate.
WHOP_ENVIRONMENT=production
WHOP_SALES_ENABLED=false
WHOP_COMPANY_ID=
WHOP_PRODUCT_ID=
WHOP_PLAN_ID=
WHOP_WEBHOOK_SECRET=
WHOP_PUBLIC_URL=http://127.0.0.1:8080
WHOP_PRICE_USD=10.00
# Optional: defaults to backend/var/whop-<environment>.sqlite3
WHOP_DATABASE=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
OPENROUTER_API_KEY=
# Direct provider model ID; choose one supported by your account.
OPENROUTER_MODEL=openai/gpt-6-luna
