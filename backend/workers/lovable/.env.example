# SERVER secrets in your Lovable project; never expose as VITE_* or frontend env.
# Lovable provisions LOVABLE_API_KEY when enabling built-in AI for the project.
LOVABLE_API_KEY=
# Copy backend/.env MODEL_BRIDGE_TOKEN here privately as WORKER_SHARED_TOKEN.
WORKER_SHARED_TOKEN=
# Exact gateway model IDs selected in your workspace; comma-separated allowlist.
ALLOWED_MODEL_IDS=
