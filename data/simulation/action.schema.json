{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Customer action v1.0",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "inspect_offer"
        },
        "offer_id": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "enum": [
            "features",
            "pricing",
            "evidence",
            "terms"
          ]
        }
      },
      "required": [
        "action",
        "offer_id",
        "section"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "compare_offers"
        },
        "offer_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2,
          "maxItems": 3,
          "uniqueItems": true
        },
        "attributes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true
        }
      },
      "required": [
        "action",
        "offer_ids",
        "attributes"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "view_sample"
        },
        "offer_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "action",
        "offer_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "decide"
        },
        "decision": {
          "type": "object",
          "properties": {
            "choice": {
              "enum": [
                "select_offer",
                "keep_current",
                "decline",
                "insufficient_information"
              ]
            },
            "offer_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            },
            "supporting_fact_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "unresolved_attributes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "required": [
            "choice",
            "offer_id",
            "reason",
            "supporting_fact_ids",
            "unresolved_attributes"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "choice": {
                    "const": "select_offer"
                  }
                }
              },
              "then": {
                "properties": {
                  "offer_id": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "else": {
                "properties": {
                  "offer_id": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        }
      },
      "required": [
        "action",
        "decision"
      ],
      "additionalProperties": false
    }
  ]
}
