{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "overview": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "customer_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "minItems": 1,
            "maxItems": 50
          }
        },
        "required": [
          "text",
          "customer_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 5,
      "maxItems": 5
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "segment_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "feedback": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "next_step": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "customer_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "minItems": 1,
            "maxItems": 50
          }
        },
        "required": [
          "segment_id",
          "name",
          "feedback",
          "next_step",
          "customer_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 50
    },
    "improvements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 800
          },
          "next_step": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "customer_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "minItems": 1,
            "maxItems": 50
          }
        },
        "required": [
          "title",
          "explanation",
          "next_step",
          "customer_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 6
    }
  },
  "required": [
    "overview",
    "segments",
    "improvements"
  ],
  "additionalProperties": false
}
