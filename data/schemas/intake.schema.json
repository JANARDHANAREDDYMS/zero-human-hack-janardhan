{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "intake v2.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "product_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,79}$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "research_question": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "category": {
      "type": [
        "string",
        "null"
      ]
    },
    "audience": {
      "type": [
        "string",
        "null"
      ]
    },
    "market": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "country": {
              "type": [
                "string",
                "null"
              ]
            },
            "language": {
              "type": [
                "string",
                "null"
              ]
            },
            "currency": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "price": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "amount": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "currency": {
              "type": [
                "string",
                "null"
              ]
            },
            "billing_period": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "known_features": {
      "type": "object"
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "url",
              "document_reference",
              "note"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "kind",
          "value"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "product_id",
    "description",
    "research_question"
  ],
  "additionalProperties": false
}
