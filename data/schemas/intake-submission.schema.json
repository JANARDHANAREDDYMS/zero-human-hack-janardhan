{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "product_id",
    "text"
  ],
  "properties": {
    "product_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,79}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000,
      "pattern": "\\S"
    },
    "research_question": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
