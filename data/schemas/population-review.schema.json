{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Qualitative population review v3.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "summary",
    "findings",
    "checks"
  ],
  "properties": {
    "decision": {
      "enum": [
        "accept",
        "revise",
        "reject"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "severity",
          "message",
          "source_ids"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "blocking",
              "warning"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "status",
          "rationale",
          "segment_ids",
          "customer_ids",
          "source_ids"
        ],
        "properties": {
          "category": {
            "enum": [
              "coverage",
              "segment_distinctness",
              "within_segment_variation",
              "evidence_support",
              "assumption_transparency",
              "product_independence",
              "simulation_fit"
            ]
          },
          "status": {
            "enum": [
              "pass",
              "warning",
              "fail"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "segment_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "customer_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
