{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "contract_version",
    "stage",
    "model",
    "request_id",
    "instruction_version",
    "data",
    "usage",
    "instruction_sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.1"
    },
    "stage": {
      "enum": [
        "compact_propose",
        "compact_correct",
        "intake_extract",
        "research_extract",
        "propose",
        "review",
        "correct",
        "simulate_customer",
        "simulate_concept",
        "summarize_simulation",
        "extract_review_concerns"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "instruction_version": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object"
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "cost_usd",
        "cost_basis"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "cost_basis": {
          "enum": [
            "provider_reported",
            "configured_estimate",
            "unavailable"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "cost_basis": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "properties": {
              "cost_usd": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "cost_usd": {
                "type": "number"
              }
            }
          }
        }
      ]
    },
    "instruction_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
